}.left-block {
    background: radial-gradient(ellipse at center center, #ffffff 0%, #f2f2f2 100%);
    color: #8b8e97;
    padding: 10px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
